# ==========================================================
# Academia-Industry Collaboration Portal - Environment Config
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------
# Option A: Local MySQL Database (XAMPP / MySQL Workbench)
# ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=academia_industry_portal
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# ----------------------------------------------------------
# Option B: Cloud MySQL Database (TiDB Cloud / Aiven / Remote)
# If DATABASE_URL is set, it takes precedence over DB_HOST.
# ----------------------------------------------------------
# DATABASE_URL=mysql://<username>:<password>@<gateway-host>:4000/academia_industry_portal?ssl={"rejectUnauthorized":true}

# JWT Authentication
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1h

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=./uploads

# ----------------------------------------------------------
# Render Anti-Spin-Down (Keep-Alive) Configuration
# Render free services spin down after 15 min of inactivity.
# ----------------------------------------------------------
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MINUTES=13
# RENDER_EXTERNAL_URL is automatically set by Render when deployed.
# Or provide your public Render URL manually:
# KEEP_ALIVE_URL=https://academia-industry-portal.onrender.com
